name: RAPOMAN publish

on:
  push:
    paths:
      - 'queue/*.json'
  workflow_dispatch:
    inputs:
      queue_file:
        description: 'queue JSON path'
        required: false
        type: string

permissions:
  contents: write

concurrency:
  group: rapoman-publisher
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      HATENA_ID: ${{ secrets.HATENA_ID }}
      HATENA_API_KEY: ${{ secrets.HATENA_API_KEY }}
      HATENA_BLOG_ID: rapomarublog.hatenablog.com
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: Select queue file
        id: q
        shell: bash
        run: |
          if [ -n "${{ inputs.queue_file }}" ]; then
            q="${{ inputs.queue_file }}"
          else
            q=$(git diff --name-only HEAD^ HEAD -- 'queue/*.json' | tail -n 1)
          fi
          test -n "$q" && test -f "$q"
          echo "file=$q" >> "$GITHUB_OUTPUT"

      - name: Validate secrets exist
        shell: bash
        run: |
          test -n "$HATENA_ID"
          test -n "$HATENA_API_KEY"

      - name: Publish and audit
        run: python3 rapoman_cloud_publish.py "${{ steps.q.outputs.file }}"

      - name: Commit result
        if: always()
        shell: bash
        run: |
          if git status --porcelain results/ | grep -q .; then
            git config user.name 'rapoman-bot'
            git config user.email 'actions@users.noreply.github.com'
            git add results/
            git commit -m "Record RAPOMAN publish result"
            git push
          fi
